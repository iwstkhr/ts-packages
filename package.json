{
  "name": "ts-packages",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "test": "npm test --workspaces",
    "typecheck": "npm run typecheck --workspaces"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@tsconfig/node24": "24.0.5",
    "@types/node": "24.13.4",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
